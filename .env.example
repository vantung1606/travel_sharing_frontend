# Wayfare Backend API Endpoint
# Local development: http://localhost:8081/api
# Production Railway: https://travelsharingbackend-production.up.railway.app/api
VITE_API_URL=http://localhost:8081/api

# Google OAuth 2.0 Client ID for Google Sign-In
# Lấy từ Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
