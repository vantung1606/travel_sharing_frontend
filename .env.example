# Google Gemini API Key for WanderAI
# Điền khóa API của bạn tại đây hoặc cấu hình qua giao diện Admin AI Config
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Client ID for Google Sign-In
# Lấy từ Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
# Ví dụ: 123456789-abcdef.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
